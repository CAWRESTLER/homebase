# Copy to .env.local for local dev, or set these in Netlify → Site configuration → Environment variables.
# Leave them unset to run in browser-only (localStorage) mode.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Optional: the owner's Supabase Auth email (defaults to mx9556@gmail.com). Never put the password here.
# VITE_OWNER_EMAIL=owner@example.com
